class iterator:
    def __init__(self,n):
        self.position = -1
        self.oddnums = []
        for _ in range(n):
            self.oddnums.append(2*_+1)
    def __iter__(self):
        return self
    def __next__(self):
        self.position += 1
        if self.position < len(self.oddnums):
            return self.oddnums[self.position]
        else:
            raise StopIteration
