    def __rsub__(self,number):  
        return(number-self.num)
    def __mul__(self,number):
        return(self.num * number)
    def __rmul__(self,number):
        return(self.num * number)
    def __truediv__(self,number):
        return(self.num / number)
    def __rtruediv__(self,number):
        return(number/self.num)
    def __itruediv__(self,number):
        self.num /= number
