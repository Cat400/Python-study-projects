class Fibonacchi:
    def __init__(self,number):
        self.n=number
        self.position=-1
    def __iter__(self):
        return self
    def __next__(self):
        self.position+=1
        if self.position >= self.n:
            raise StopIteration
        a=1
        b=1
        if self.position <= 1:
            return 1
        for _ in range(self.position):
            a,b = b, a+b
        return b
fib = Fibonacchi(5)
for num in fib:
    print(num, end=" ")


                
      
