class U:
    def __init__(self,*args):
        self.field=[]
        for _ in args:
            self.field.append(_)
    def show(self):
        print(self.field)
    def __eq__(self,oper):
        try:
            return self.field[0] == oper.field[0]
        except IndexError:
            if len(self.field) == len(oper.field):
                return True
            elif len(self.field) == 0:
                return 0 == oper.field[0]
            elif len(oper.field) == 0:
                return self.field[0] == 0
    def __ne__(self,oper):
        try:
            return self.field[1] != oper.field[1]
        except IndexError:
            if len(self.field) == len(oper.field):
                return True
            elif len(self.field) == 1:
                return 0 != oper.field[1]
            elif len(oper.field) == 1:
                return self.field[1] != 0
    def __lt__(self,oper):
        try:
            return self.field[2] < oper.field[2]
        except IndexError:
            if len(self.field) == len(oper.field):
                return True
            elif len(self.field) == 2:
                return 0 < oper.field[2]
            elif len(oper.field) == 2:
                return self.field[2] < 0
    def __gt__(self,oper):
        try:
            return self.field[3] > oper.field[3]
        except IndexError:
            if len(self.field) == len(oper.field):
                return True
            elif len(self.field) == 3:
                return 0 > oper.field[3]
            elif len(oper.field) == 3:
                return self.field[3] > 0
    def __le__(self,oper):
        try:
            return self.field[4] <= oper.field[4]
        except IndexError:
            if len(self.field) == len(oper.field):
                return True
            elif len(self.field) == 4:
                return 0 <= oper.field[4]
            elif len(oper.field) == 4:
                return self.field[4] <= 0
    def __ge__(self,oper):
        try:
            return self.field[4] >= oper.field[4]
        except IndexError:
            if len(self.field) == len(oper.field):
                return True
            elif len(self.field) == 4:
                return 0 >= oper.field[4]
            elif len(oper.field) == 4:
                return self.field[4] >= 0
    def __contains__(self,oper):
        try:
            return self.field[5] in oper.field
        except IndexError:
            return False
